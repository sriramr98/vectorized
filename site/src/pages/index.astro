---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Vectorized — Build a Vector Database" description="An interactive field guide to building an LSM-tree database and vector search engine in Go.">
  <section class="hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <p class="hero-index">BUILDING VECTORIZED</p>
    <div class="hero-copy">
      <p class="eyebrow">An engineering blog</p>
      <h1>A VECTOR<br /><span>DATABASE.</span></h1>
      <p class="hero-deck">I’m building an LSM-tree database with vector search in Go. This blog follows the project chapter by chapter, from the TCP server to persistent storage and indexing.</p>
      <div class="hero-actions">
        <a class="button-bright" href="/book">Start the project <span>→</span></a>
      </div>
    </div>
    <div class="hero-orbit" aria-hidden="true">
      <div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="orbit orbit-three"></div>
      <div class="vector-point point-a"></div><div class="vector-point point-b"></div><div class="vector-point point-c"></div>
      <span class="axis-label label-x">DIM_384</span><span class="axis-label label-y">COSINE</span>
    </div>
    <div class="hero-status">LSM TREES · VECTOR SEARCH · GO</div>
  </section>
</BaseLayout>
